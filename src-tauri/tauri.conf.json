{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OmniJXL",
  "version": "1.1.2",
  "identifier": "com.omnijxl.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OmniJXL - High Performance JPEG XL Converter",
        "width": 1240,
        "height": 900,
        "minWidth": 980,
        "minHeight": 640,
        "decorations": false,
        "transparent": true,
        "dragDropEnabled": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "languages": [
          "English"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
